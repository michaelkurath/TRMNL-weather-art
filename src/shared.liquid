{% template weather_art %}
  {% assign scene = 'village' %}
  {% assign requested_artist = settings.artist %}
  {% case settings.scene %}
    {% when 'city' %}
      {% assign scene = 'city' %}
      {% case settings.city_artist %}
        {% when 'van-gogh', 'warhol', 'neutral' %}
          {% assign requested_artist = settings.city_artist %}
      {% endcase %}
    {% when 'mountain-lake' %}
      {% assign scene = 'mountain-lake' %}
      {% assign requested_artist = 'neutral' %}
  {% endcase %}

  {% assign artist = 'van-gogh' %}
  {% case requested_artist %}
    {% when 'warhol', 'neutral' %}
      {% assign artist = requested_artist %}
    {% when 'picasso' %}
      {% if scene == 'village' %}
        {% assign artist = 'picasso' %}
      {% endif %}
  {% endcase %}

  {% assign condition = 'clear' %}
  {% assign wind_kmh = wind_speed | default: 0 | plus: 0 %}
  {% assign code = weather_code | append: '' %}
  {% assign daylight = is_day | append: '' %}
  {% case code %}
    {% when '95', '96', '97', '99' %}
      {% assign condition = 'thunderstorm' %}
    {% when '71', '73', '75', '77', '85', '86' %}
      {% assign condition = 'snow' %}
    {% when '45', '48' %}
      {% assign condition = 'fog' %}
    {% when '51', '53', '55', '56', '57', '61', '63', '65', '66', '67', '80', '81', '82' %}
      {% if wind_kmh >= 30 %}
        {% assign condition = 'windy-rain' %}
      {% else %}
        {% assign condition = 'calm-rain' %}
      {% endif %}
    {% when '0', '1', '2', '3' %}
      {% if wind_kmh >= 30 %}
        {% assign condition = 'dry-wind' %}
      {% elsif code == '3' %}
        {% assign condition = 'overcast' %}
      {% elsif code == '0' and daylight == '0' and wind_speed != nil %}
        {% if artist == 'neutral' or artist == 'picasso' %}
          {% assign condition = 'clear-night' %}
        {% endif %}
      {% endif %}
  {% endcase %}

  {% capture artwork_url %}https://raw.githubusercontent.com/michaelkurath/TRMNL-weather-art/main/artwork/frame/{{ scene }}/{{ artist }}/{{ condition }}{% endcapture %}
  {% capture artwork_alt %}Weather Art, {{ scene }}, {{ condition | replace: '-', ' ' }}{% endcapture %}
  <div class="layout">
    {% if shape != 'tall' %}
      <img class="image image--contain image-dither w--full h--full{% if shape != 'wide' %} portrait:hidden{% endif %}"
           src="{{ artwork_url }}.jpg" alt="{{ artwork_alt }}">
    {% endif %}
    {% if shape != 'wide' %}
      <img class="image image--contain image-dither w--full h--full{% if shape != 'tall' %} hidden portrait:visible{% endif %}"
           src="{{ artwork_url }}-portrait.jpg" alt="{{ artwork_alt }}">
    {% endif %}
  </div>
{% endtemplate %}
