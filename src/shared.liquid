{% template weather_art %}
  {% assign artist = 'van-gogh' %}
  {% if settings.artist == 'warhol' %}
    {% assign artist = 'warhol' %}
  {% elsif settings.artist == 'neutral' %}
    {% assign artist = 'neutral' %}
  {% endif %}

  {% assign scene = 'village' %}
  {% if settings.scene == 'city' %}
    {% assign scene = 'city' %}
  {% endif %}

  {% assign condition = 'clear' %}
  {% if weather_code != nil and weather_code != blank %}
    {% assign code = weather_code | append: '' %}
    {% case code %}
      {% when '45', '48', '71', '73', '75', '77', '85', '86' %}
        {% assign condition = 'fog' %}
      {% when '51', '53', '55', '56', '57', '61', '63', '65', '66', '67', '80', '81', '82', '95', '96', '97', '99' %}
        {% assign condition = 'windy-rain' %}
    {% endcase %}
  {% endif %}

  {% capture artwork_url %}https://raw.githubusercontent.com/michaelkurath/TRMNL-weather-art/main/artwork/frame/{{ scene }}/{{ artist }}/{{ condition }}{% endcapture %}
  {% capture artwork_alt %}Weather Art, {{ scene }}, {{ condition | replace: '-', ' ' }}{% endcapture %}
  <div class="layout">
    <img class="image image--contain image-dither w--full h--full{% if artist == 'neutral' %} portrait:hidden{% endif %}"
         src="{{ artwork_url }}.jpg" alt="{{ artwork_alt }}">
    {% if artist == 'neutral' %}
      <img class="image image--contain image-dither w--full h--full hidden portrait:visible"
           src="{{ artwork_url }}-portrait.jpg" alt="{{ artwork_alt }}">
    {% endif %}
  </div>
{% endtemplate %}
